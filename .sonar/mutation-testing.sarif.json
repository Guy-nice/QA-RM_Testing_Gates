{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "Unified Mutation Testing",
          "rules": [
            {
              "id": "mutation-testing:no-coverage",
              "shortDescription": {
                "text": "No test reaches this line (mutation testing, ?):"
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "mutation-testing:survived:ConditionalBoundary",
              "shortDescription": {
                "text": "A test executes this line but does not kill the mutation (ConditionalBoundary):"
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            }
          ]
        }
      },
      "results": [
        {
          "ruleId": "mutation-testing:no-coverage",
          "message": {
            "text": "No test reaches this line (mutation testing, ?):"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/calculator.ts"
                },
                "region": {
                  "startLine": 17,
                  "endLine": 17
                }
              }
            }
          ]
        },
        {
          "ruleId": "mutation-testing:survived:ConditionalBoundary",
          "message": {
            "text": "A test executes this line but does not kill the mutation (ConditionalBoundary):"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/calculator.ts"
                },
                "region": {
                  "startLine": 10,
                  "endLine": 10
                }
              }
            }
          ]
        }
      ]
    }
  ]
}