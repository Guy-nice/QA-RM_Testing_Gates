{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "testRunner": "command",
  "commandRunner": {
    "command": "npm test"
  },
  "mutate": [
    "src/calculator.ts"
  ],
  "reporters": ["html", "clear-text", "progress", "json"],
  "htmlReporter": {
    "fileName": "mutation-reports/mutation.html"
  },
  "jsonReporter": {
    "fileName": "mutation-reports/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  }
}
